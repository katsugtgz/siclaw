# syntax=docker/dockerfile:1
# AgentBox Docker Image — multi-stage build
# Stage 1: build (tsc)
# Stage 2: production runtime
#
# Security: dual-user model (ADR-010, docs/design/security.md)
#   agentbox — main Node.js process, owns credentials
#   sandbox  — all child processes (shell commands). NO credential group: it must not be able to
#              open a credential file at all. The only sandbox-side reader is kubectl, which reaches
#              the cluster credentials through its setgid bit; a group membership here would hand
#              every other binary in the image the same access and make that setgid bit decorative.
#   kubectl  — setgid kubecred group, reads kubeconfig via group permission
#   host credentials — no sandbox-side reader exists: `ssh` is not in the command whitelist, and
#              host_exec dials from the node process (running as agentbox, the owner) via ssh2. The
#              setgid `ssh` once planned here was never built and is not needed.

# ── Build stage ──────────────────────────────────────────────────
FROM node:22.19-slim AS builder

WORKDIR /app

# Dependencies layer (cached unless package*.json changes)
COPY package*.json ./
COPY patches/ ./patches/
COPY scripts/install/ ./scripts/install/
RUN npm ci

# Copy backend source only (AgentBox runtime graph: agentbox-main + core + tools + knowledge).
# Gateway code (spawners, security, db) is intentionally NOT built here — the
# agentbox image runs only agentbox-main.ts, which never imports src/gateway/*.
# Those modules are compiled in the runtime/portal images instead.
COPY tsconfig.json tsconfig.agentbox.json ./
COPY src/agentbox-main.ts ./src/
COPY src/agentbox/ ./src/agentbox/
COPY src/core/ ./src/core/
COPY src/cron/ ./src/cron/
COPY src/knowledge/ ./src/knowledge/
COPY src/memory/ ./src/memory/
COPY src/shared/ ./src/shared/
COPY src/script-sandbox/ ./src/script-sandbox/
COPY src/tools/ ./src/tools/
# Type-only file consumed by core/agent-factory.ts and core/extensions/* —
# keeps Portal runtime code (db, rest-router) out of the agentbox tsc graph.
COPY src/portal/cli-snapshot-types.ts ./src/portal/

# Backend build (agentbox-specific tsconfig, excludes gateway server/portal/channel code)
RUN npx tsc -p tsconfig.agentbox.json

# Build Codex from Siclaw's reviewed main branch in the internal upstream mirror.
FROM rust:1.95-bookworm AS codex-builder
ARG CODEX_COMMIT=d4684bba63aba4c941d5a251054609e722b64779
RUN apt-get update && apt-get install -y --no-install-recommends \
    git openssh-client ca-certificates pkg-config libcap-dev clang make \
    && rm -rf /var/lib/apt/lists/*
COPY docker/gitlab-known-hosts /etc/ssh/ssh_known_hosts
RUN --mount=type=ssh,required=true git init /src/codex \
    && git -C /src/codex remote add origin git@gitlab.scitix-inner.ai:aiops/codex.git \
    && git -C /src/codex fetch --depth 1 origin refs/heads/main \
    && git -C /src/codex checkout --detach FETCH_HEAD \
    && test "$(git -C /src/codex rev-parse HEAD)" = "${CODEX_COMMIT}"
RUN cd /src/codex/codex-rs && cargo build --release --locked -p codex-cli --bin codex \
    && target/release/codex --version
RUN apt-get update && apt-get install -y --no-install-recommends curl python3 \
    && rm -rf /var/lib/apt/lists/*
COPY docker/build-codex-code-mode-host.sh /usr/local/bin/build-codex-code-mode-host.sh
RUN bash /usr/local/bin/build-codex-code-mode-host.sh /src/codex

# ── Production stage ─────────────────────────────────────────────
FROM node:22.19-slim

# System deps + kubectl in one layer
#
# The text-processing commands the tool whitelist permits must actually EXIST here, or a permitted
# command fails with 127 and the tool's own description is a lie. This image is the execution
# context for restricted-bash only — node_exec resolves binaries in the node's namespaces and
# pod_exec inside the target container, so neither gains anything from this layer.
#   bsdextrautils — provides `column` (moved out of bsdmainutils on bookworm)
#   ripgrep       — the `grep` tool runs `rg`; without it pi downloads the latest release from
#                   GitHub at call time, which fails offline and otherwise runs an unreviewed binary
#   yq            — mikefarah/yq, installed as a WRAPPER; see the yq layer below
#
# yq is pinned to an exact version and checksum rather than `releases/latest`: an unverified
# `latest` means the same source commit builds a different, unreviewed executable every time.
ARG YQ_VERSION=v4.53.3
ARG YQ_SHA256=fa52a4e758c63d38299163fbdd1edfb4c4963247918bf9c1c5d31d84789eded4
#
# kubectl is pinned and must prove it runs. Resolving "latest" at build time and saving whatever
# came back once shipped a 239-byte object-store error page as /usr/local/bin/kubectl: the version
# lookup failed on the build host, the URL lost its version segment, and curl without -f stored the
# NoSuchKey XML. Every cluster read in the box then died before reaching an API server.
ARG KUBECTL_VERSION=v1.36.4
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl jq python3 ca-certificates sudo fonts-noto-cjk chromium bsdextrautils ripgrep libcap2 bubblewrap \
    && curl -fsSL --retry 3 -o /usr/local/bin/kubectl \
       "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
    && chmod +x /usr/local/bin/kubectl \
    && /usr/local/bin/kubectl version --client \
    && rm -rf /var/lib/apt/lists/*

# yq: real binary under a name the command whitelist does not admit, reached only through a wrapper
# that forces its security switches on.
#
# yq's expression language reads files and the environment by itself — `load_str(env(X) + "/y")`
# needs no flag and no path argument — so argv screening alone cannot bound it. validateYq rejects
# those operators in every execution context; this wrapper is the second layer, and the only one
# that still holds if a future operator escapes the screen. `yq-real` is not in the whitelist, so
# the unwrapped binary is not reachable by name or by absolute path.
RUN curl -fsSL -o /usr/local/lib/yq-real "https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_amd64" \
    && echo "${YQ_SHA256}  /usr/local/lib/yq-real" | sha256sum -c - \
    && chmod 0755 /usr/local/lib/yq-real \
    && printf '%s\n' '#!/bin/sh' \
       'exec /usr/local/lib/yq-real --security-disable-file-ops --security-disable-env-ops "$@"' \
       > /usr/local/bin/yq \
    && chmod 0755 /usr/local/bin/yq

# User & group setup (dual-user isolation) — single layer
# node:22-slim has UID 1000 (node user) — remove it first to avoid conflicts
RUN userdel -r node 2>/dev/null || true \
    && groupadd --gid 1002 kubecred \
    && groupadd --gid 1003 hostcred \
    && useradd --uid 1000 -m -s /bin/bash -G kubecred,hostcred agentbox \
    && useradd --uid 1001 -M -s /bin/false sandbox \
    && echo 'agentbox ALL=(sandbox) NOPASSWD:SETENV: ALL' > /etc/sudoers.d/sandbox-exec \
    && chmod 440 /etc/sudoers.d/sandbox-exec \
    && chgrp kubecred /usr/local/bin/kubectl \
    && chmod 2755 /usr/local/bin/kubectl

WORKDIR /app

# Production deps (cached unless package*.json changes)
COPY package*.json ./
COPY patches/ ./patches/
COPY scripts/install/ ./scripts/install/
RUN npm ci --omit=dev

# Copy only the binary from the official source build, never an npm wrapper.
COPY --from=codex-builder /src/codex/codex-rs/target/release/codex /usr/local/bin/codex
COPY --from=codex-builder /src/codex/codex-rs/target/release/codex-code-mode-host /usr/local/bin/codex-code-mode-host
RUN codex --version && codex-code-mode-host --help >/dev/null && bwrap --version

# Copy compiled JS + skills + entrypoint (knowledge synced at runtime via bundle API)
COPY --from=builder /app/dist/ ./dist/
COPY skills/core/ ./skills/core/
COPY skills/extension/ ./skills/extension/
COPY skills/platform/ ./skills/platform/
COPY docker/agentbox-entrypoint.sh /usr/local/bin/agentbox-entrypoint.sh

# Fail the build if a command this image advertises is not actually here — see the script. Runs
# after dist/ so it can derive the list from the same table the validator uses.
COPY docker/agentbox-capability-check.sh /usr/local/bin/agentbox-capability-check.sh
RUN chmod +x /usr/local/bin/agentbox-capability-check.sh && /usr/local/bin/agentbox-capability-check.sh
# Deployment-specific extra command whitelist (additive-only; loaded at agent
# startup — docs/design/2026-06-10-extra-command-whitelist.md). Replace the
# file content before building to whitelist site-specific diagnostic binaries.
COPY docker/extra-commands.json /etc/siclaw/extra-commands.json

# Build every stdio MCP listed in mcp/MCP_LIST.txt and symlink each into PATH.
# To add a new MCP: drop a new mcp/<name>/ directory (standalone npm package
# with bin -> ./dist/index.js) and append its name to MCP_LIST.txt.
COPY mcp/ /opt/mcp-staging/
RUN set -eu \
    && grep -v '^[[:space:]]*#' /opt/mcp-staging/MCP_LIST.txt | grep -v '^[[:space:]]*$' | tr -d ' \t' | while IFS= read -r name; do \
         [ -n "$name" ] || continue; \
         echo "=== Building mcp-$name ==="; \
         src="/opt/mcp-staging/$name"; dst="/opt/mcp-$name"; \
         test -d "$src" || { echo "MCP_LIST.txt names '$name' but $src is missing"; exit 1; }; \
         mkdir -p "$dst"; \
         cp "$src/package.json" "$src/package-lock.json" "$src/tsconfig.json" "$dst/"; \
         cp -r "$src/src" "$dst/src"; \
         cd "$dst"; \
         npm ci; \
         npx tsc; \
         npm prune --omit=dev; \
         chmod +x dist/index.js; \
         chown -R agentbox:agentbox "$dst"; \
         ln -sf "$dst/dist/index.js" "/usr/local/bin/mcp-$name"; \
         cd /; \
       done \
    && rm -rf /opt/mcp-staging

# Directory structure, permissions, SUID/SGID cleanup — single layer
RUN chmod +x /usr/local/bin/agentbox-entrypoint.sh \
    && mkdir -p ./.siclaw/skills ./.siclaw/credentials/clusters ./.siclaw/credentials/hosts ./.siclaw/config ./.siclaw/user-data \
    && chown -R agentbox:agentbox . \
    && chown agentbox:agentbox ./.siclaw/credentials \
    && chmod 0750 ./.siclaw/credentials \
    && chown agentbox:kubecred ./.siclaw/credentials/clusters \
    && chmod 2750 ./.siclaw/credentials/clusters \
    && chown agentbox:hostcred ./.siclaw/credentials/hosts \
    && chmod 2750 ./.siclaw/credentials/hosts \
    && chmod 0700 ./.siclaw/config \
    && chmod 0755 ./.siclaw/skills \
    && chmod 0777 ./.siclaw/user-data \
    && chmod -R o+rX ./dist/ ./skills/ ./node_modules/ \
    && find / -perm /4000 -type f ! -path '/proc/*' 2>/dev/null | while read -r f; do \
         case "$f" in /usr/bin/sudo) ;; *) chmod u-s "$f" ;; esac; done \
    && find / -perm /2000 -type f ! -path '/proc/*' 2>/dev/null | while read -r f; do \
         case "$f" in /usr/local/bin/kubectl) ;; *) chmod g-s "$f" ;; esac; done

ENV NODE_ENV=production

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fk https://localhost:3000/health || curl -f http://localhost:3000/health || exit 1

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/agentbox-entrypoint.sh"]
CMD ["node", "dist/agentbox-main.js"]
